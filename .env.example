# Copy to .env.local and fill in real values. .env.local is git-ignored.
# Never commit real keys. Never put the service_role / secret key here:
# every VITE_* variable is bundled into the browser.

# Persistence backend for TV content:
#   local    - browser localStorage (offline prototype / rollback)
#   supabase - authenticated shared backend (production)
VITE_DATA_BACKEND=supabase

# Supabase project API URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (sb_publishable_...). Safe for the browser;
# access is enforced by Row Level Security.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
