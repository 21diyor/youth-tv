# Copy to .env.local and fill in. .env.local is git-ignored.

# Persistence backend for TV content: "local" (browser localStorage, default)
# or "supabase" (not connected yet — reserved for the next migration step).
VITE_DATA_BACKEND=local

# Supabase project settings (used once the supabase backend is enabled).
# Only the publishable/anon key belongs here — never the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
